# Copy to .env for local development. All values are optional locally.
PORT=4000
NODE_ENV=development

# Required in production (Render generates one). Long random string.
JWT_SECRET=

# Browser origins allowed by CORS (comma separated, origin only).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=43200

# Rate limits: requests/minute per IP for the API, and per 15 minutes for
# login/registration/password-reset/refresh/account-lookup.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# Express "trust proxy": 1 behind one reverse proxy (Render), loopback locally.
TRUST_PROXY=loopback

# Restore the seed every N minutes (0 = only on restart / POST /system/reset).
AUTO_RESET_MINUTES=0

# Alternate dataset file (defaults to data/seed.json).
# SEED_FILE=
